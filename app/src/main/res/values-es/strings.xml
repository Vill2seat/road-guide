    <!-- Permission screen -->
    <string name="permission_title">Permisos para Road Guide</string>
    <string name="permission_description">
        Road Guide necesita acceso a tu ubicación y notificaciones
        para rastrear automáticamente tu exposición ambiental
        en segundo plano, incluso cuando la app está cerrada.
    </string>
    <string name="permission_location_title">Ubicación</string>
    <string name="permission_location_desc">
        Para registro automático de rutas y cálculo de exposición en tiempo real
    </string>
    <string name="permission_notification_title">Notificaciones</string>
    <string name="permission_notification_desc">
        Para alertas de umbral de exposición y operación del rastreador en segundo plano
    </string>
    <string name="permission_grant">Conceder permisos</string>

    <!-- Onboarding -->
    <string name="onboarding_welcome_title">Bienvenido a Road Guide</string>
    <string name="onboarding_welcome_desc">
        Road Guide te ayuda a rastrear tu exposición ambiental durante el día.
        La aplicación registra tus rutas, evalúa la calidad del aire y el ruido
        en los lugares que visitas, y genera informes diarios.
    </string>
    <string name="onboarding_info_title">Cómo funciona</string>
    <string name="onboarding_info_auto_title">Registro automático de rutas</string>
    <string name="onboarding_info_auto_desc">
        La aplicación registra tus movimientos en segundo plano y calcula la exposición ambiental.
    </string>
    <string name="onboarding_info_notif_title">Notificaciones</string>
    <string name="onboarding_info_notif_desc">
        Recibirás alertas cuando se excedan los niveles seguros de exposición.
    </string>
    <string name="onboarding_info_privacy_title">Privacidad</string>
    <string name="onboarding_info_privacy_desc">
        Todos los datos se almacenan localmente en tu dispositivo. Nada se envía a la nube sin tu consentimiento.
    </string>

