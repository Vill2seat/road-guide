    <!-- Onboarding -->
    <string name="onboarding_welcome_title">Welcome to Road Guide</string>
    <string name="onboarding_welcome_desc">
        Road Guide helps you track your environmental exposure throughout the day.
        The app records your routes, evaluates air quality and noise at places you visit,
        and generates daily reports.
    </string>
    <string name="onboarding_info_title">How it works</string>
    <string name="onboarding_info_auto_title">Automatic route recording</string>
    <string name="onboarding_info_auto_desc">
        The app records your movements in the background and calculates environmental exposure.
    </string>
    <string name="onboarding_info_notif_title">Notifications</string>
    <string name="onboarding_info_notif_desc">
        You will receive alerts when safe exposure levels are exceeded.
    </string>
    <string name="onboarding_info_privacy_title">Privacy</string>
    <string name="onboarding_info_privacy_desc">
        All data is stored locally on your device. Nothing is sent to the cloud without your consent.
    </string>

