    <!-- Permission screen -->
    <string name="permission_title">Разрешения для Road Guide</string>
    <string name="permission_description">
        Road Guide нуждается в доступе к вашему местоположению и уведомлениям,
        чтобы автоматически отслеживать ваше воздействие на окружающую среду
        в фоновом режиме, даже когда приложение свернуто.
    </string>
    <string name="permission_location_title">Местоположение</string>
    <string name="permission_location_desc">
        Для автоматической записи маршрутов и расчёта воздействия в реальном времени
    </string>
    <string name="permission_notification_title">Уведомления</string>
    <string name="permission_notification_desc">
        Для оповещений о превышении порога воздействия и фоновой работы трекера
    </string>
    <string name="permission_grant">Дать разрешения</string>

    <!-- Onboarding -->
    <string name="onboarding_welcome_title">Добро пожаловать в Road Guide</string>
    <string name="onboarding_welcome_desc">
        Road Guide помогает отслеживать ваше воздействие на окружающую среду
        в течение дня. Приложение записывает ваши маршруты, оценивает качество
        воздуха и шума по местам пребывания и формирует дневные отчёты.
    </string>
    <string name="onboarding_info_title">Как это работает</string>
    <string name="onboarding_info_auto_title">Автозапись маршрутов</string>
    <string name="onboarding_info_auto_desc">
        Приложение записывает ваши перемещения в фоне и рассчитывает воздействие на окружающую среду.
    </string>
    <string name="onboarding_info_notif_title">Уведомления</string>
    <string name="onboarding_info_notif_desc">
        Вы будете получать оповещения при превышении безопасного уровня воздействия.
    </string>
    <string name="onboarding_info_privacy_title">Конфиденциальность</string>
    <string name="onboarding_info_privacy_desc">
        Все данные хранятся локально на вашем устройстве. Ничего не отправляется в облако без вашего согласия.
    </string>

